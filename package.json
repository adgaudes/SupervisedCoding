{
  "name": "pi-supervised-coding",
  "version": "0.1.0",
  "description": "Supervised multi-model coding for the Pi coding agent: one model plans, delegates and accepts; Claude and GPT workers implement; checks, reviews, credit failover and learning are automatic.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "coding-agent",
    "claude-code",
    "claude",
    "gpt",
    "multi-model",
    "code-review"
  ],
  "homepage": "https://github.com/adgaudes/SupervisedCoding#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adgaudes/SupervisedCoding.git"
  },
  "bugs": {
    "url": "https://github.com/adgaudes/SupervisedCoding/issues"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test:unit": "node --test tests/lib.test.ts tests/learning.test.ts tests/routing.test.ts tests/changes.test.ts",
    "test:integration": "node --import ./tests/resolve-pi.mjs --test tests/integration.test.ts tests/regressions.test.ts tests/settings.test.ts",
    "typecheck": "node tests/typecheck.mjs",
    "test": "npm run test:unit && npm run test:integration && npm run typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  }
}
